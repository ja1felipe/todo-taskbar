{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todo Taskbar",
  "version": "0.2.7",
  "identifier": "com.felipe.todobar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Todo Taskbar",
        "width": 380,
        "height": 520,
        "resizable": true,
        "minWidth": 300,
        "minHeight": 520,
        "maxHeight": 520,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERjI0MTk2RjAwRURDRTgKUldUbzNBN3dsa0h5N1JmNm9FMzRTMVd0QzZ3ajFCQ3pVamJoUEJJcDd1QkM4V1RRcjZGWE9acVMK",
      "endpoints": [
        "https://github.com/ja1felipe/todo-taskbar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
