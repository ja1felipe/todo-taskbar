# URL do projeto Supabase (Project Settings -> API -> Project URL).
# Ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave pública "anon" do projeto (Project Settings -> API -> anon public).
# Pode ser embutida no app: o acesso é limitado pelas políticas de RLS.
SUPABASE_ANON_KEY=

# Senha do banco (Project Settings -> Database -> Connection string).
# Usada apenas por ferramentas de administração/migração (ex.: Supabase CLI).
# NUNCA é embutida no app.
SUPABASE_PASSWORD=

# Personal Access Token do Supabase (Account -> Access Tokens).
# Usado apenas pela CLI para aplicar migrações. NUNCA é embutido no app.
SUPABASE_ACCESS_TOKEN=
